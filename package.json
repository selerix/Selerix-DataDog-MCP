{
  "name": "@selerix/datadog-mcp",
  "version": "1.22.0",
  "mcpName": "io.github.us-all/datadog",
  "description": "Datadog MCP server - 175 tools for metrics, monitors, logs, APM, RUM, incidents, CI/CD, Synthetics browser tests, status pages, fleet automation, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "datadog-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "server.json",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/selerix/Selerix-DataDog-MCP.git"
  },
  "homepage": "https://github.com/selerix/Selerix-DataDog-MCP#readme",
  "bugs": "https://github.com/selerix/Selerix-DataDog-MCP/issues",
  "keywords": [
    "mcp",
    "datadog",
    "monitoring",
    "observability",
    "apm",
    "rum",
    "model-context-protocol"
  ],
  "author": "us-all",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/selerix/_packaging/Selerix/npm/registry/"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "hono": "^4.12.25",
      "fast-uri": "^3.1.2",
      "ip-address": "^10.1.1",
      "form-data": "^4.0.6"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/ui','dist/ui',{recursive:true})\"",
    "prepack": "npm run build",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "presmoke": "pnpm run build",
    "smoke": "node scripts/smoke-test.mjs",
    "pretoken-stats": "pnpm run build",
    "token-stats": "node scripts/measure-tokens.mjs"
  },
  "dependencies": {
    "@datadog/datadog-api-client": "~1.59.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^17.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.6",
    "vitest": "^4.1.12"
  }
}
