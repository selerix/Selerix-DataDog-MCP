DD_API_KEY=your-api-key-here
DD_APP_KEY=your-app-key-here
# Must be an official site: datadoghq.com, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com, ap2.datadoghq.com, datadoghq.eu, ddog-gov.com
DD_SITE=us5.datadoghq.com

# Writes are off by default and write tools are then not advertised at all.
# DD_ALLOW_WRITE=true enables every write tool EXCEPT fleet, security and status-pages.
# DD_WRITE_TOOLS (categories and/or tool names, or "all") replaces DD_ALLOW_WRITE when set; prefer it:
# DD_WRITE_TOOLS=synthetics
# DD_WRITE_TOOLS=set-synthetics-test-status,update-synthetics-browser-test
# Audit log of tool calls as JSON lines on stderr: all | writes (default) | off
# DD_AUDIT_LOG=writes

# Developers only: max estimated tokens for the full tool list, enforced by `pnpm run token-stats`
# (CI uses the TOKEN_BUDGET repo variable, default 35000). Unset or 0 disables the check locally.
# TOKEN_BUDGET=35000
