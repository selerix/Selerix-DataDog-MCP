DD_API_KEY=your-api-key-here
DD_APP_KEY=your-app-key-here
# Must be an official site: datadoghq.com, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com, ap2.datadoghq.com, datadoghq.eu, ddog-gov.com
DD_SITE=us5.datadoghq.com

# Developers only: max estimated tokens for the full tool list, enforced by `pnpm run token-stats`
# (CI uses the TOKEN_BUDGET repo variable, default 35000). Unset or 0 disables the check locally.
# TOKEN_BUDGET=35000
